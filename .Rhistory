print(m1)
m2 <- matrix(v2, nrow = 3) # this is a 3x3 matrix
print(m2)
# By default, matrix function fills the matrix column by column.
# To fill it row by row, set the byrow argument to TRUE or T.
m3 <- matrix(v2, nrow = 3, byrow = T)
print(m3)
# DATAFRAMES #########################
v3 <- c("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep")
print(v3)
df1 <- cbind(v2, v3) # dataframe with 2 columns
print(df1)
df2 <- data.frame(v2, v3) # dataframe with 2 columns
# data.frame() function preserves the data types of the columns.
print(df2)
print(is.array(a4))
print(is.matrix(m3))
print(is.data.frame(df2))
View(df2)
View(df1)
View(df1)
View(df2)
View(df2)
view(v1)
View(m1)
View(a3)
View(v2)
# LISTS #####################
# Lists are most flexible, but can be unwieldy to work with.
# They are very useful while working with JSON data.
l1 <- list(v1, v2, a3, df2)
print(l1)
